<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>A birthday surprise for you</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Figtree:ital,wght@0,400;0,600;0,800;1,400&display=swap" rel="stylesheet">

<style>
:root{
  --night:#150a2b;
  --plum:#2b1055;
  --pink:#ff4d8d;
  --sun:#ffd23f;
  --mint:#4adebc;
  --sky:#7cc8ff;
  --violet:#b794ff;
  --bg:#f3e8ff;
  --paper:#fff8fc;
  --ink:#2b1055;
  --display:"Bagel Fat One","Trebuchet MS","Arial Rounded MT Bold",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}

@media (prefers-color-scheme:dark){
  :root{
    --bg:#22103f;
    --paper:#321a5c;
    --ink:#fff1fb;
  }
}

*,
*::before,
*::after{
  box-sizing:border-box;
}

html{
  scroll-padding-top:env(safe-area-inset-top,0px);
  min-height:100%;
}

body{
  margin:0;
  min-height:100%;
  background:var(--night);
  color:#fff;
  font-family:var(--body);
  line-height:1.5;
  overflow-x:hidden;
  -webkit-tap-highlight-color:transparent;
}

button{
  font:inherit;
  color:inherit;
  cursor:pointer;
  border:0;
  background:none;
}

:focus-visible{
  outline:3px solid var(--sun);
  outline-offset:3px;
  border-radius:6px;
}

h1,h2,h3,p{
  margin:0;
}

/* =========================
   STAGE
========================= */

.stage{
  display:none;
}

.stage.active{
  display:flex;
}

.solo{
  min-height:100svh;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:1.4rem;
  padding:1.5rem 1.2rem 4rem;
  text-align:center;
  position:relative;

  background:
    radial-gradient(1.5px 1.5px at 12% 18%,#fff8 50%,transparent 51%),
    radial-gradient(1.5px 1.5px at 78% 12%,#fff9 50%,transparent 51%),
    radial-gradient(2px 2px at 40% 30%,#fff6 50%,transparent 51%),
    radial-gradient(1.5px 1.5px at 90% 55%,#fff7 50%,transparent 51%),
    radial-gradient(2px 2px at 8% 70%,#fff6 50%,transparent 51%),
    radial-gradient(1.5px 1.5px at 62% 82%,#fff8 50%,transparent 51%),
    var(--night);
}

.solo h1{
  font-family:var(--display);
  font-weight:400;
  font-size:clamp(1.9rem,7vw,3rem);
  line-height:1.1;
  max-width:15ch;
}

.hint{
  min-height:1.6em;
  color:#d9c8ff;
  font-size:1.02rem;
  max-width:34ch;
}

.btn{
  display:inline-block;
  padding:.85rem 1.5rem;
  border-radius:999px;
  background:var(--sun);
  color:var(--plum);
  font-weight:800;
  font-size:1.05rem;
  box-shadow:0 5px 0 #c99a00;
  transition:transform .12s,box-shadow .12s;
}

.btn:active{
  transform:translateY(4px);
  box-shadow:0 1px 0 #c99a00;
}

.btn.ghost{
  background:transparent;
  color:#fff;
  box-shadow:inset 0 0 0 2px #ffffff55;
}

.btn.ghost:active{
  transform:none;
}

.row{
  display:flex;
  flex-wrap:wrap;
  gap:.8rem;
  justify-content:center;
}

/* =========================
   GIFT
========================= */

.gift{
  position:relative;
  width:min(58vw,230px);
  aspect-ratio:1;
  margin-top:1rem;
  cursor:pointer;
  animation:wiggle 3.2s ease-in-out infinite;
}

.gift .glow{
  position:absolute;
  inset:-60%;
  background:radial-gradient(
    circle,
    #ffd23fcc 0,
    #ff4d8d66 30%,
    transparent 60%
  );
  opacity:0;
  transform:scale(.3);
  transition:opacity .5s,transform .8s;
}

.gift .box{
  position:absolute;
  left:7%;
  right:7%;
  bottom:0;
  height:62%;
  background:var(--pink);
  border-radius:6px 6px 14px 14px;
  box-shadow:inset -14px 0 0 #0002;
}

.gift .box::after{
  content:"";
  position:absolute;
  left:50%;
  top:0;
  bottom:0;
  width:20%;
  transform:translateX(-50%);
  background:var(--sun);
}

.gift .lid{
  position:absolute;
  left:0;
  right:0;
  top:12%;
  height:28%;
  background:#ff2f7c;
  border-radius:10px;
  transition:transform .6s cubic-bezier(.2,1.5,.4,1);
  box-shadow:inset -14px 0 0 #0002;
  z-index:2;
}

.gift .lid::after{
  content:"";
  position:absolute;
  left:50%;
  top:0;
  bottom:0;
  width:20%;
  transform:translateX(-50%);
  background:var(--sun);
}

.gift .lid::before{
  content:"";
  position:absolute;
  left:50%;
  top:-34px;
  width:62px;
  height:42px;
  transform:translateX(-50%);
  z-index:3;

  background:
    radial-gradient(
      circle at 50% 100%,
      var(--sun) 0 9px,
      transparent 10px
    ),
    conic-gradient(
      from 90deg at 50% 100%,
      transparent 0 25%,
      var(--sun) 25% 40%,
      transparent 40% 60%,
      var(--sun) 60% 75%,
      transparent 75%
    );

  border-radius:50% 50% 8px 8px;
}

.gift .tag{
  position:absolute;
  right:-4%;
  bottom:12%;
  z-index:3;
  background:var(--paper);
  color:var(--plum);
  font-weight:800;
  font-size:.8rem;
  padding:.35rem .6rem;
  border-radius:4px 10px 10px 4px;
  transform:rotate(8deg);
  box-shadow:0 3px 0 #0003;
  max-width:9ch;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.gift.open{
  animation:none;
}

.gift.open .lid{
  transform:translate(18%,-150%) rotate(26deg);
}

.gift.open .glow{
  opacity:1;
  transform:scale(1);
}

@keyframes wiggle{
  0%,70%,100%{transform:rotate(0)}
  74%{transform:rotate(-5deg)}
  80%{transform:rotate(5deg)}
  86%{transform:rotate(-4deg)}
  92%{transform:rotate(3deg)}
}

/* =========================
   REVEAL
========================= */

#s2{
  flex-direction:column;
  background:var(--bg);
  color:var(--ink);
}

.hero{
  min-height:100svh;
  background:var(--night);
  color:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:2rem 1rem 5rem;
  position:relative;
  overflow:hidden;
}

.hero::after{
  content:"";
  position:absolute;
  left:0;
  right:0;
  bottom:-1px;
  height:70px;
  background:var(--bg);

  clip-path:polygon(
    0 100%,
    0 60%,
    6% 25%,
    12% 60%,
    18% 25%,
    24% 60%,
    30% 25%,
    36% 60%,
    42% 25%,
    48% 60%,
    54% 25%,
    60% 60%,
    66% 25%,
    72% 60%,
    78% 25%,
    84% 60%,
    90% 25%,
    96% 60%,
    100% 40%,
    100% 100%
  );
}

.greet{
  font-family:var(--display);
  font-size:clamp(2.4rem,10.5vw,5.8rem);
  line-height:1;
  letter-spacing:.01em;
}

.greet .w{
  display:inline-block;
  white-space:nowrap;
  margin:0 .12em;
}

.ch{
  display:inline-block;
  animation:drop .8s cubic-bezier(.2,1.6,.4,1) both;
  animation-delay:calc(var(--i) * 55ms);
}

.ch:nth-child(4n+1){color:var(--sun)}
.ch:nth-child(4n+2){color:var(--mint)}
.ch:nth-child(4n+3){color:var(--sky)}
.ch:nth-child(4n){color:#fff}

.nm{
  font-family:var(--display);
  font-size:clamp(3.6rem,19vw,10.5rem);
  line-height:.95;
  color:var(--pink);
  margin-top:.15em;
  overflow-wrap:anywhere;
}

.nm.long{
  font-size:clamp(2.4rem,11vw,6.5rem);
}

.nm .ch{
  color:var(--pink);
}

.nm .ch:nth-child(3n+2){
  color:#ff7aa9;
}

@keyframes drop{
  from{
    opacity:0;
    transform:translateY(-120%) rotate(-14deg) scale(.6);
  }
}

.age{
  margin-top:1.4rem;
  display:inline-block;
  padding:.45rem 1.1rem;
  border-radius:999px;
  background:var(--sun);
  color:var(--plum);
  font-weight:800;
  transform:rotate(-3deg);
}

.down{
  margin-top:2.2rem;
  color:#d9c8ff;
}

.arrow{
  display:block;
  width:16px;
  height:16px;
  margin:.7rem auto 0;
  border-right:3px solid var(--sun);
  border-bottom:3px solid var(--sun);
  transform:rotate(45deg);
  animation:nudge 1.4s ease-in-out infinite;
}

@keyframes nudge{
  50%{
    transform:translateY(8px) rotate(45deg);
  }
}

.sec{
  width:100%;
  max-width:880px;
  margin:0 auto;
  padding:3rem 1.2rem 1.5rem;
}

.sec h2{
  font-family:var(--display);
  font-weight:400;
  font-size:clamp(1.7rem,6vw,2.6rem);
  line-height:1.1;
  margin-bottom:.4rem;
}

.sec>p{
  max-width:46ch;
  opacity:.85;
}

.sec>p.cnt{
  margin-top:.8rem;
  font-weight:800;
}

/* =========================
   SCRATCH CARD
========================= */

.scratchwrap{
  position:relative;
  width:min(100%,420px);
  height:210px;
  margin:1.6rem auto 0;
  transform:rotate(-2deg);
  border-radius:18px;
  overflow:hidden;
  box-shadow:
    0 8px 0 var(--pink),
    0 18px 30px #0003;
}

.under{
  position:absolute;
  inset:0;
  background:var(--sun);
  color:var(--plum);
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:1rem 1.4rem;
  font-family:var(--display);
  font-size:clamp(1.3rem,5vw,1.8rem);
  line-height:1.2;
}

#scratch{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  touch-action:none;
  cursor:crosshair;
  transition:opacity .7s;
}

#scratch.done{
  opacity:0;
  pointer-events:none;
}

/* =========================
   ENVELOPES
========================= */

.envs{
  display:grid;
  grid-template-columns:repeat(
    auto-fit,
    minmax(150px,1fr)
  );
  gap:1.1rem;
  margin-top:1.6rem;
}

.env{
  perspective:900px;
  height:205px;
  position:relative;
  text-align:left;
}

.env:nth-child(odd){
  transform:rotate(-1.6deg);
}

.env:nth-child(even){
  transform:rotate(1.8deg);
  margin-top:.6rem;
}

.env .inner{
  position:absolute;
  inset:0;
  transform-style:preserve-3d;
  transition:
    transform .7s cubic-bezier(.3,1.3,.5,1);
}

.env[aria-pressed="true"] .inner{
  transform:rotateY(180deg);
}

.face{
  position:absolute;
  inset:0;
  border-radius:12px;
  backface-visibility:hidden;
  -webkit-backface-visibility:hidden;
  padding:.9rem;
  overflow:hidden;
  box-shadow:0 6px 0 #0002;
}

/* FRONT OF ENVELOPE */

.front{
  background:var(--c);
  color:var(--plum);
  display:flex;
  align-items:flex-end;
  justify-content:center;
  font-weight:800;
  font-size:.85rem;
}

.front::before{
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:58%;
  background:#0000001c;
  clip-path:polygon(
    0 0,
    100% 0,
    50% 100%
  );
}

.front::after{
  content:"";
  position:absolute;
  left:50%;
  top:44%;
  width:34px;
  height:34px;
  margin:-17px 0 0 -17px;
  border-radius:50%;
  background:var(--paper);
  box-shadow:0 3px 0 #0002;
}

.front span{
  position:relative;
  z-index:1;
}

/* FIXED BACK OF ENVELOPE
   WHITE TEXT FOR READABILITY
*/

.back{
  transform:rotateY(180deg);

  /* dark background */
  background:var(--plum);

  /* WHITE TEXT */
  color:#fff;

  display:flex;
  flex-direction:column;
  gap:.55rem;

  border:3px solid var(--c);

  text-shadow:0 1px 2px #0005;
}

.back b{
  font-family:var(--display);
  font-weight:400;
  font-size:1.35rem;
  line-height:1.1;
  color:#fff;
}

.back span{
  font-size:.92rem;
  line-height:1.4;
  color:#fff;
}

/* =========================
   BALLOONS
========================= */

.sky{
  position:relative;
  height:330px;
  margin-top:1.4rem;
  border-radius:22px;
  background:linear-gradient(
    #7cc8ff,
    #d4f0ff
  );
  overflow:hidden;
  box-shadow:0 7px 0 #0002;
}

.sky::after{
  content:"";
  position:absolute;
  left:-10%;
  right:-10%;
  bottom:-40px;
  height:90px;

  background:
    radial-gradient(
      circle at 20px 60px,
      #fff 38px,
      transparent 39px
    )
    0 0/90px 90px repeat-x;
}

.bl{
  position:absolute;
  bottom:34px;
  width:64px;
  height:78px;
  border-radius:
    50% 50% 48% 48% /
    58% 58% 42% 42%;

  background:var(--c);

  box-shadow:
    inset -9px -8px 0 #0002,
    inset 8px 8px 0 #fff4;

  animation:
    bob var(--d)
    ease-in-out infinite;

  z-index:2;

  transition:
    transform .25s,
    opacity .25s;
}

.bl::before{
  content:"";
  position:absolute;
  left:50%;
  bottom:-8px;
  margin-left:-6px;
  border:6px solid transparent;
  border-bottom:9px solid var(--c);
  border-top:0;
}

.bl::after{
  content:"";
  position:absolute;
  left:50%;
  top:100%;
  width:2px;
  height:60px;
  background:#2b105555;
}

.bl.pop{
  transform:scale(1.6);
  opacity:0;
  pointer-events:none;
  animation:none;
}

@keyframes bob{
  50%{
    transform:
      translateY(-34px)
      rotate(3deg);
  }
}

.words{
  display:flex;
  flex-wrap:wrap;
  gap:.5rem;
  margin-top:1rem;
  min-height:2.4rem;
}

.word{
  padding:.3rem .8rem;
  border-radius:999px;
  background:var(--c);
  color:var(--plum);
  font-weight:800;
  animation:
    drop .6s
    cubic-bezier(.2,1.6,.4,1)
    both;
}

/* =========================
   LETTER
========================= */

.letter{
  margin:1.6rem 0 0;
  background:var(--paper);
  color:var(--ink);
  border-radius:6px 22px 6px 22px;
  padding:clamp(1.2rem,4vw,2.2rem);
  box-shadow:0 8px 0 var(--violet);
  position:relative;
  white-space:pre-wrap;
  font-size:1.08rem;
  line-height:1.7;
  min-height:15rem;
}

.letter .cur{
  display:inline-block;
  width:2px;
  height:1.1em;
  background:var(--pink);
  vertical-align:-.15em;
  animation:blink .8s steps(1) infinite;
}

@keyframes blink{
  50%{
    opacity:0;
  }
}

/* =========================
   FINALE
========================= */

.finale{
  display:flex;
  flex-wrap:wrap;
  gap:.8rem;
  margin:2rem 0 5rem;
}

.finale .btn.ghost{
  color:var(--ink);
  box-shadow:
    inset 0 0 0 2px var(--ink);
}

#fx{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:50;
}

.banner{
  position:fixed;
  left:0;
  right:0;
  top:36%;
  text-align:center;
  font-family:var(--display);
  font-size:clamp(2.2rem,9vw,5rem);
  color:#fff;

  text-shadow:
    0 4px 0 var(--pink),
    0 0 40px #ff4d8d;

  opacity:0;
  pointer-events:none;
  z-index:55;

  transform:scale(.6);

  transition:
    opacity .4s,
    transform .6s
    cubic-bezier(.2,1.6,.4,1);

  padding:0 1rem;
}

.banner.show{
  opacity:1;
  transform:scale(1);
}

/* =========================
   REDUCED MOTION
========================= */

@media (prefers-reduced-motion:reduce){

  *,
  *::before,
  *::after{
    animation:none!important;
    transition-duration:.01ms!important;
  }

}
</style>
</head>

<body data-stage="0">

<!-- =========================
     STAGE 0
========================= -->

<main class="stage solo active" id="s0">

  <h1>
    There's a gift here.
  </h1>

  <div
    class="gift"
    id="gift"
    role="button"
    tabindex="0"
    aria-label="Open the gift"
  >

    <div class="glow"></div>
    <div class="box"></div>
    <div class="lid"></div>

    <div class="tag">
      Sis
    </div>

  </div>

  <p class="hint">
    Tap the box to open it.
  </p>

</main>


<!-- =========================
     STAGE 2
========================= -->

<div class="stage" id="s2">

  <header class="hero">

    <h1
      class="greet"
      id="greet"
      aria-label="Happy Birthday"
    ></h1>

    <p class="nm" id="nm"></p>

    <span
      class="age"
      id="age"
      hidden
    ></span>

    <p class="down">
      Scroll down. There's more hidden in here.
      <span class="arrow"></span>
    </p>

  </header>


  <!-- SCRATCH -->

  <section
    class="sec"
    id="sec-scratch"
  >

    <h2>
      Scratch the silver card
    </h2>

    <p>
      Use your finger or mouse. It says something about you.
    </p>

    <div
      class="scratchwrap"
      id="scratchwrap"
    >

      <div class="under">
        <span>
          Plot twist: Lucky to have you as my sister. 
        </span>
      </div>

      <canvas
        id="scratch"
        aria-label="Scratch card"
      ></canvas>

    </div>

  </section>


  <!-- ENVELOPES -->

  <section
    class="sec"
    id="sec-env"
  >

    <h2>
      Six wishes, sealed
    </h2>

    <p>
      Each envelope holds one thing I hope for you this year.
      Open them all.
    </p>

    <div
      class="envs"
      id="envs"
    ></div>

    <p
      class="cnt"
      id="envcnt"
    >
      0 of 6 opened
    </p>

  </section>


  <!-- BALLOONS -->

  <section
    class="sec"
    id="sec-bal"
  >

    <h2>
      Pop all seven balloons
    </h2>

    <p>
      Each one is a fact about you. No arguing with them.
    </p>

    <div
      class="sky"
      id="sky"
    ></div>

    <div
      class="words"
      id="words"
      aria-live="polite"
    ></div>

    <p
      class="cnt"
      id="balcnt"
    >
      0 of 7 popped
    </p>

  </section>


  <!-- LETTER -->

  <section
    class="sec"
    id="sec-letter"
  >

    <h2>
      One last thing
    </h2>

    <div
      class="letter"
      id="letter"
      aria-live="off"
    ></div>

    <div class="finale">

      <button
        class="btn"
        id="fire"
      >
        Launch the finale
      </button>

      <button
        class="btn ghost"
        id="replay"
      >
        Start over
      </button>

    </div>

  </section>

</div>


<canvas
  id="fx"
  aria-hidden="true"
></canvas>

<div
  class="banner"
  id="banner"
  aria-hidden="true"
></div>


<script>
(() => {

  const $ = (s,r=document) =>
    r.querySelector(s);

  const $$ = (s,r=document) =>
    [...r.querySelectorAll(s)];

  const reduce =
    matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

  const rand =
    a =>
      a[
        Math.floor(
          Math.random() * a.length
        )
      ];

  const wait =
    ms =>
      new Promise(
        r => setTimeout(r,ms)
      );


  /* =========================
     PERSONAL DETAILS
  ========================= */

  const S = {
    to:'Sis',
    from:'Your sibling',
    age:'',
    msg:''
  };


  const defaultLetter = () =>
`Dear ${S.to},

Another year older, and you're still the first person I'd call when something goes wrong and when something goes right. Thank you for the inside jokes, the secrets you've kept, and for always being on my side.

I hope this year is gentle with you and generous to you. You deserve every good thing that's coming.

Happy birthday.
${S.from}`;


  const letterText = () =>
    S.msg.trim() || defaultLetter();


  /* =========================
     CONFETTI
  ========================= */

  const cv =
    $('#fx');

  const cx =
    cv.getContext('2d');

  let W = 0;
  let H = 0;
  let D = 1;
  let P = [];
  let raf = 0;


  const COLORS = [
    '#ff4d8d',
    '#ffd23f',
    '#4adebc',
    '#7cc8ff',
    '#ffffff',
    '#b794ff'
  ];


  function fit(){

    D =
      Math.min(
        devicePixelRatio || 1,
        2
      );

    W = innerWidth;
    H = innerHeight;

    cv.width =
      W * D;

    cv.height =
      H * D;

    cx.setTransform(
      D,
      0,
      0,
      D,
      0,
      0
    );
  }


  addEventListener(
    'resize',
    fit
  );

  fit();


  function kick(){

    if(!raf)
      raf =
        requestAnimationFrame(
          frame
        );
  }


  function burst(
    x,
    y,
    n=90,
    spread=1
  ){

    if(reduce)
      n =
        Math.round(n / 4);


    for(
      let i=0;
      i<n;
      i++
    ){

      const a =
        Math.random() *
        Math.PI * 2;

      const s =
        (3 + Math.random()*9) *
        spread;


      P.push({

        t:'c',

        x,
        y,

        vx:
          Math.cos(a) * s,

        vy:
          Math.sin(a) * s - 4,

        g:.22,

        fr:.985,

        life:1,

        decay:
          .005 +
          Math.random()*.006,

        w:
          6 +
          Math.random()*7,

        h:
          4 +
          Math.random()*5,

        c:
          rand(COLORS),

        r:
          Math.random()*6.28,

        vr:
          (Math.random()-.5)*.4

      });
    }

    kick();
  }


  function sparks(
    x,
    y,
    col,
    n=70
  ){

    for(
      let i=0;
      i<n;
      i++
    ){

      const a =
        Math.random() *
        Math.PI * 2;

      const s =
        1 +
        Math.random()*6.5;


      P.push({

        t:'s',

        x,
        y,

        vx:
          Math.cos(a)*s,

        vy:
          Math.sin(a)*s,

        g:.05,

        fr:.965,

        life:1,

        decay:
          .011 +
          Math.random()*.012,

        c:col,

        w:
          2 +
          Math.random()*1.5

      });
    }

    kick();
  }


  function rocket(tx,ty){

    const g=.25;

    const startY =
      H + 10;


    P.push({

      t:'r',

      x:tx,

      y:startY,

      vx:
        (Math.random()-.5)*1.2,

      vy:
        -Math.sqrt(
          2*g*(startY-ty)
        ),

      g,

      fr:1,

      life:1,

      decay:0,

      c:
        rand(COLORS)

    });


    kick();
  }


  function frame(){

    cx.clearRect(
      0,
      0,
      W,
      H
    );


    for(
      let i=P.length-1;
      i>=0;
      i--
    ){

      const p=P[i];


      p.vx *= p.fr;

      p.vy =
        p.vy*p.fr +
        p.g;

      p.x += p.vx;
      p.y += p.vy;

      p.life -= p.decay;


      if(p.t==='r'){

        cx.globalAlpha=1;

        cx.fillStyle=p.c;

        cx.fillRect(
          p.x-1.5,
          p.y,
          3,
          10
        );


        if(p.vy>-.8){

          sparks(
            p.x,
            p.y,
            p.c,
            80
          );

          P.splice(i,1);
        }

        continue;
      }


      if(
        p.life<=0 ||
        p.y>H+40
      ){

        P.splice(i,1);

        continue;
      }


      cx.globalAlpha =
        Math.min(
          1,
          p.life*1.6
        );

      cx.fillStyle=p.c;


      if(p.t==='c'){

        p.r += p.vr;

        cx.save();

        cx.translate(
          p.x,
          p.y
        );

        cx.rotate(p.r);

        cx.fillRect(
          -p.w/2,
          -p.h/2,
          p.w,
          p.h
        );

        cx.restore();

      }else{

        cx.beginPath();

        cx.arc(
          p.x,
          p.y,
          p.w,
          0,
          6.283
        );

        cx.fill();

      }

    }


    cx.globalAlpha=1;

    raf =
      P.length
      ? requestAnimationFrame(frame)
      : 0;


    if(!raf){

      cx.clearRect(
        0,
        0,
        W,
        H
      );
    }

  }


  /* =========================
     STAGE CONTROL
  ========================= */

  let stage=0;


  function go(n){

    stage=n;


    $$('.stage')
      .forEach(s => {

        s.classList.toggle(
          'active',
          s.id === 's'+n
        );

      });


    document.body.dataset.stage=n;

    window.scrollTo(
      0,
      0
    );


    if(n===2)
      onReveal();
  }


  /* =========================
     TEXT BINDING
  ========================= */

  function split(
    el,
    text
  ){

    el.textContent='';

    let i=0;


    text
      .split(' ')
      .forEach(word => {

        const w =
          document.createElement(
            'span'
          );

        w.className='w';


        [...word].forEach(c => {

          const s =
            document.createElement(
              'span'
            );

          s.className='ch';

          s.textContent=c;

          s.style.setProperty(
            '--i',
            i++
          );

          w.appendChild(s);

        });


        el.appendChild(w);

        el.appendChild(
          document.createTextNode(' ')
        );

      });
  }


  function bind(){

    document.title =
      'Happy Birthday, ' +
      S.to +
      '!';


    split(
      $('#greet'),
      'Happy Birthday,'
    );


    const nm =
      $('#nm');


    split(
      nm,
      S.to+'!'
    );


    nm.classList.toggle(
      'long',
      S.to.length>9
    );


    const age =
      $('#age');


    if(S.age){

      age.hidden=false;

      age.textContent =
        'Now '+
        S.age+
        ' and unstoppable';

    }else{

      age.hidden=true;

    }

  }


  function onReveal(){

    bind();


    setTimeout(
      () =>
        burst(
          innerWidth/2,
          innerHeight*.35,
          120
        ),
      500
    );


    requestAnimationFrame(
      initScratch
    );
  }


  /* =========================
     GIFT
  ========================= */

  const gift =
    $('#gift');

  let opened=false;


  async function openGift(){

    if(opened)
      return;


    opened=true;

    gift.classList.add(
      'open'
    );


    await wait(450);


    const r =
      gift.getBoundingClientRect();


    burst(
      r.left+r.width/2,
      r.top+r.height*.3,
      110
    );


    await wait(1300);

    go(2);
  }


  gift.addEventListener(
    'click',
    openGift
  );


  gift.addEventListener(
    'keydown',
    e => {

      if(
        e.key==='Enter' ||
        e.key===' '
      ){

        e.preventDefault();

        openGift();

      }
    }
  );


  /* =========================
     SCRATCH CARD
  ========================= */

  let scratchReady=false;
  let scratchDone=false;


  function initScratch(){

    if(scratchReady)
      return;


    scratchReady=true;


    const c =
      $('#scratch');

    const ctx =
      c.getContext('2d');

    const wrap =
      $('#scratchwrap');


    const rect =
      wrap.getBoundingClientRect();


    const d =
      Math.min(
        devicePixelRatio||1,
        2
      );


    const w =
      c.width =
      Math.round(
        rect.width*d
      );


    const h =
      c.height =
      Math.round(
        rect.height*d
      );


    const g =
      ctx.createLinearGradient(
        0,
        0,
        w,
        h
      );


    g.addColorStop(
      0,
      '#c9b6ff'
    );

    g.addColorStop(
      .5,
      '#e9e9f5'
    );

    g.addColorStop(
      1,
      '#ff9fc4'
    );


    ctx.fillStyle=g;

    ctx.fillRect(
      0,
      0,
      w,
      h
    );


    ctx.fillStyle =
      'rgba(255,255,255,.55)';


    for(
      let i=0;
      i<70;
      i++
    ){

      ctx.beginPath();

      ctx.arc(
        Math.random()*w,
        Math.random()*h,
        (1+Math.random()*2.5)*d,
        0,
        6.283
      );

      ctx.fill();
    }


    ctx.fillStyle =
      'rgba(43,16,85,.7)';

    ctx.textAlign='center';


    ctx.font =
      '800 '+
      24*d+
      'px Figtree, system-ui, sans-serif';


    ctx.fillText(
      'Scratch here',
      w/2,
      h/2+8*d
    );


    ctx.globalCompositeOperation =
      'destination-out';


    ctx.lineWidth =
      38*d;

    ctx.lineCap =
      ctx.lineJoin =
      'round';


    let down=false;
    let lx=0;
    let ly=0;
    let moves=0;


    const pos=e => {

      const r =
        c.getBoundingClientRect();


      return [

        (e.clientX-r.left)*
        (w/r.width),

        (e.clientY-r.top)*
        (h/r.height)

      ];
    };


    function clearedShare(){

      const data =
        ctx.getImageData(
          0,
          0,
          w,
          h
        ).data;


      let n=0;
      let t=0;


      for(
        let i=3;
        i<data.length;
        i+=64
      ){

        t++;

        if(data[i]===0)
          n++;
      }


      return n/t;
    }


    function finish(){

      if(scratchDone)
        return;


      scratchDone=true;


      c.classList.add(
        'done'
      );


      const r =
        wrap.getBoundingClientRect();


      burst(
        r.left+r.width/2,
        r.top+r.height/2,
        110
      );
    }


    c.addEventListener(
      'pointerdown',
      e => {

        down=true;

        [lx,ly]=pos(e);

        c.setPointerCapture(
          e.pointerId
        );


        ctx.beginPath();

        ctx.arc(
          lx,
          ly,
          19*d,
          0,
          6.283
        );

        ctx.fill();

      }
    );


    c.addEventListener(
      'pointermove',
      e => {

        if(!down)
          return;


        const [x,y]=pos(e);


        ctx.beginPath();

        ctx.moveTo(
          lx,
          ly
        );

        ctx.lineTo(
          x,
          y
        );

        ctx.stroke();


        lx=x;
        ly=y;


        if(
          ++moves%14===0 &&
          clearedShare()>.5
        ){

          finish();

        }
      }
    );


    const up=()=>{

      if(down){

        down=false;

        if(
          clearedShare()>.5
        )
          finish();

      }
    };


    c.addEventListener(
      'pointerup',
      up
    );

    c.addEventListener(
      'pointercancel',
      up
    );

  }


  /* =========================
     ENVELOPES
  ========================= */

  const WISHES=[

    [
      'Laughter',
      'May you laugh so hard this year that your stomach hurts and nobody remembers why.',
      '#ffd23f'
    ],

    [
      'Courage',
      'May the big thing you have been scared of finally look small.',
      '#4adebc'
    ],

    [
      'Rest',
      'May you get slow mornings, warm tea and zero guilt about either.',
      '#7cc8ff'
    ],

    [
      'Luck',
      'May every light turn green and the last good parking spot be yours.',
      '#ff9fc4'
    ],

    [
      'Us',
      'May we keep being the two people who know each other\'s worst stories.',
      '#b794ff'
    ],

    [
      'Cake',
      'And may the first slice always be bigger than you planned.',
      '#ffb35c'
    ]

  ];


  const envs =
    $('#envs');

  let openedEnv=0;


  WISHES.forEach(
    ([t,txt,col]) => {

      const b =
        document.createElement(
          'button'
        );


      b.className='env';

      b.setAttribute(
        'aria-pressed',
        'false'
      );


      b.style.setProperty(
        '--c',
        col
      );


      b.innerHTML=`

        <span class="inner">

          <span class="face front">
            <span>Tap to open</span>
          </span>

          <span class="face back">
            <b></b>
            <span></span>
          </span>

        </span>

      `;


      $('b',b).textContent=t;

      $('.back > span',b)
        .textContent=txt;


      let seen=false;


      b.addEventListener(
        'click',
        () => {

          const on =
            b.getAttribute(
              'aria-pressed'
            )==='true';


          b.setAttribute(
            'aria-pressed',
            String(!on)
          );


          if(!on&&!seen){

            seen=true;

            openedEnv++;


            $('#envcnt')
              .textContent =
              openedEnv+
              ' of '+
              WISHES.length+
              ' opened'+
              (
                openedEnv===
                WISHES.length
                ? '. Every wish is yours.'
                : ''
              );


            const r =
              b.getBoundingClientRect();


            burst(
              r.left+r.width/2,
              r.top+r.height/2,
              35,
              .7
            );


            if(
              openedEnv===
              WISHES.length
            ){

              setTimeout(
                () =>
                  burst(
                    innerWidth/2,
                    innerHeight/3,
                    120
                  ),
                500
              );

            }

          }

        }
      );


      envs.appendChild(b);

    }
  );


  /* =========================
     BALLOONS
  ========================= */

  const TRAITS=[
    'Brilliant',
    'Brave',
    'Hilarious',
    'Kind',
    'Stylish',
    'Unstoppable',
    'Funny'
  ];


  const sky =
    $('#sky');

  let popped=0;


  TRAITS.forEach(
    (t,i) => {

      const b =
        document.createElement(
          'button'
        );


      b.className='bl';


      b.setAttribute(
        'aria-label',
        'Balloon, tap to pop'
      );


      b.style.left =
        (
          4+
          i*(84/(TRAITS.length-1))
        )+'%';


      b.style.setProperty(
        '--c',
        COLORS[
          i%4===0
          ? 0
          : i%4===1
          ? 1
          : i%4===2
          ? 2
          : 3
        ]
      );


      b.style.setProperty(
        '--d',
        (
          2.6+
          (i%4)*.5
        )+'s'
      );


      b.style.animationDelay =
        (-i*.4)+'s';


      b.style.marginLeft =
        '-32px';


      b.style.bottom =
        (
          34+
          (i%3)*62
        )+'px';


      b.addEventListener(
        'click',
        () => {

          if(
            b.classList.contains(
              'pop'
            )
          )
            return;


          b.classList.add(
            'pop'
          );


          popped++;


          const r =
            b.getBoundingClientRect();


          burst(
            r.left+r.width/2,
            r.top+r.height/2,
            45,
            .8
          );


          const chip =
            document.createElement(
              'span'
            );


          chip.className='word';

          chip.textContent=t;


          chip.style.setProperty(
            '--c',
            b.style.getPropertyValue(
              '--c'
            )
          );


          $('#words')
            .appendChild(chip);


          $('#balcnt')
            .textContent =
            popped+
            ' of '+
            TRAITS.length+
            ' popped'+
            (
              popped===
              TRAITS.length
              ? '. Seven for seven, all true.'
              : ''
            );


          if(
            popped===
            TRAITS.length
          )
            fireworks(3200);

        }
      );


      sky.appendChild(b);

    }
  );


  /* =========================
     LETTER
  ========================= */

  let typed=false;
  let typeToken=0;


  async function typeLetter(){

    if(typed)
      return;


    typed=true;


    const el =
      $('#letter');

    const txt =
      letterText();

    const tok =
      ++typeToken;


    if(reduce){

      el.textContent=txt;

      return;
    }


    el.textContent='';


    const cur =
      document.createElement(
        'span'
      );

    cur.className='cur';


    const node =
      document.createTextNode('');


    el.append(
      node,
      cur
    );


    for(
      let i=0;
      i<txt.length;
      i++
    ){

      if(tok!==typeToken)
        return;


      node.data += txt[i];


      await wait(
        txt[i]==='\n'
        ? 220
        : /[.,]/.test(txt[i])
        ? 110
        : 22
      );

    }


    cur.remove();

  }


  new IntersectionObserver(
    (es,ob) => {

      if(
        es.some(
          e=>e.isIntersecting
        )
      ){

        typeLetter();

        ob.disconnect();

      }

    },
    {
      threshold:.35
    }
  ).observe(
    $('#letter')
  );


  /* =========================
     FINALE
  ========================= */

  let showing=false;


  async function fireworks(
    ms=6500
  ){

    if(showing)
      return;


    showing=true;


    const b =
      $('#banner');


    b.textContent =
      'Happy Birthday, '+
      S.to+
      '!';


    b.classList.add(
      'show'
    );


    const end =
      Date.now()+ms;


    while(
      Date.now()<end
    ){

      rocket(
        W*(
          .12+
          Math.random()*.76
        ),

        H*(
          .12+
          Math.random()*.38
        )
      );


      await wait(
        reduce
        ? 900
        : 380+
          Math.random()*320
      );

    }


    await wait(1400);


    b.classList.remove(
      'show'
    );


    showing=false;

  }


  $('#fire')
    .addEventListener(
      'click',
      () => fireworks()
    );


  /* =========================
     START OVER
  ========================= */

  $('#replay')
    .addEventListener(
      'click',
      () => {

        opened=false;

        gift.classList.remove(
          'open'
        );


        $$('.env')
          .forEach(
            e =>
              e.setAttribute(
                'aria-pressed',
                'false'
              )
          );


        openedEnv=0;


        $('#envcnt')
          .textContent =
          '0 of 6 opened';


        $$('.bl')
          .forEach(
            b =>
              b.classList.remove(
                'pop'
              )
          );


        popped=0;


        $('#words')
          .textContent='';


        $('#balcnt')
          .textContent =
          '0 of 7 popped';


        $('#scratch')
          .classList.remove(
            'done'
          );


        scratchReady=false;
        scratchDone=false;


        const c =
          $('#scratch');


        c.getContext('2d')
          .globalCompositeOperation =
          'source-over';


        go(0);

      }
    );


  /* =========================
     INITIALIZE
  ========================= */

  bind();


  $('#s2 .hero')
    .addEventListener(
      'click',
      e => {

        if(
          e.target.closest(
            '.hero'
          )
        ){

          burst(
            e.clientX,
            e.clientY,
            40,
            .8
          );

        }

      }
    );

})();
</script>

</body>
</html>
